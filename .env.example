# Без .env используются значения по умолчанию из docker-compose.yml

# источник deals_bigdata и DWH
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SOURCE_DB_NAME=deals_bigdata
DWH_DB_NAME=dwh

# Объём синтетического источника (sql/source/synthetic.sql)
N_PRICES=300000

# Техническая учётная запись пайплайна: читает источник, владеет DWH
ETL_DB_USER=ul_etl
ETL_DB_PASSWORD=ul_etl

# «сегодня» для витрин и ML
AS_OF=2026-10-26
RANDOM_SEED=42

# --profile bonus_task: ClickHouse
CLICKHOUSE_ADMIN_PASSWORD=admin
CLICKHOUSE_ETL_USER=ul_etl
CLICKHOUSE_ETL_PASSWORD=ul_etl
CLICKHOUSE_DATABASE=ul_platform
CLICKHOUSE_HTTP_PORT=8123

# --profile bonus_task: Airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_PORT=8080
